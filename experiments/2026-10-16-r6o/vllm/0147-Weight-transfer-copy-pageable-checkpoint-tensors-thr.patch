From 7ca37fad3736b950b41215f5b37228da3c677119 Mon Sep 17 00:00:00 2001
From: Christopher Owen <3221756+christopherowen@users.noreply.github.com>
Date: Fri, 16 Oct 2026 10:32:02 +0200
Subject: [PATCH 147/148] Weight transfer: copy pageable checkpoint tensors
 through pinned memory

A checkpoint tensor is often a view of a memory-mapped file: safetensors'
get_tensor returns one at the tensor's offset in the file. On GB10 the
copy engine reads pageable memory through the host page tables, and with
driver R580 (580.178.04) on the 64 KiB-page kernel a host-to-device copy
above about 128 KiB never completes when the file pages are not yet
mapped in the process and the copy does not start on a page boundary:
the host spins in cuMemcpyHtoDAsync, the GPU is idle, and nothing is
logged. Anonymous memory, pages already read, a page-aligned start and
copies up to 128 KiB all complete. The Engram descriptor-loading test hit
it on its first 3.9 MB weight.

copy_weight's plain copy now pins a pageable CPU source first, so the CPU
reads the file and the transfer is a DMA from pinned memory. Loads through
a weight writer (the b12x loader) are unchanged. The new test copies from
an untouched mapping at offset 1504 in a child process with a timeout.

diff --git a/tests/model_executor/model_loader/test_weight_transfer.py b/tests/model_executor/model_loader/test_weight_transfer.py
index d6f593b5a..5ab749f22 100644
--- a/tests/model_executor/model_loader/test_weight_transfer.py
+++ b/tests/model_executor/model_loader/test_weight_transfer.py
@@ -104,3 +104,42 @@ def test_explicit_completion_preserves_rank_local_flush_boundaries():
     assert calls == ["flush", "finish"]
     finish_weight_transfers()
     assert calls == ["flush", "finish"]
+
+
+_MAPPED_COPY = """
+import mmap, os, sys
+import torch
+from vllm.model_executor.weight_transfer import copy_weight
+
+path, offset, nbytes = sys.argv[1], 1504, 1 << 20
+with open(path, "wb") as file:
+    file.write(os.urandom(nbytes + 2 * 65536))
+mapping = mmap.mmap(os.open(path, os.O_RDONLY), 0, access=mmap.ACCESS_COPY)
+# A view into file pages this process has not touched, off a page boundary, as a
+# safetensors tensor is.
+source = torch.frombuffer(mapping, dtype=torch.uint8)[offset : offset + nbytes]
+destination = torch.empty(nbytes, dtype=torch.uint8, device="cuda")
+copy_weight(destination, source)
+torch.cuda.synchronize()
+with open(path, "rb") as file:
+    expected = file.read()[offset : offset + nbytes]
+assert destination.cpu().numpy().tobytes() == expected
+"""
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires CUDA")
+def test_copy_from_an_untouched_file_mapping_completes(tmp_path):
+    """A checkpoint tensor that views memory-mapped file pages the process has not
+    touched, starting off a page boundary, reaches the device. (A pageable copy of it
+    never completes with driver R580 on a 64 KiB-page GB10 kernel.) The copy runs in a
+    child process so a hang fails the test instead of the suite."""
+    import subprocess
+    import sys
+
+    result = subprocess.run(
+        [sys.executable, "-c", _MAPPED_COPY, str(tmp_path / "weights.bin")],
+        capture_output=True,
+        text=True,
+        timeout=180,
+    )
+    assert result.returncode == 0, result.stderr[-2000:]
diff --git a/vllm/model_executor/weight_transfer.py b/vllm/model_executor/weight_transfer.py
index 25be5b1ed..81cf2eaa6 100644
--- a/vllm/model_executor/weight_transfer.py
+++ b/vllm/model_executor/weight_transfer.py
@@ -48,6 +48,18 @@ def weight_transfer(
 def copy_weight(destination: torch.Tensor, source: torch.Tensor) -> torch.Tensor:
     writer = _writer.get()
     if destination.is_meta or writer is None or not writer(destination, source):
+        if (
+            destination.is_cuda
+            and source.device.type == "cpu"
+            and not source.is_pinned()
+        ):
+            # A checkpoint tensor is often a view of a memory-mapped file (safetensors).
+            # On GB10, a pageable copy above about 128 KiB reads the source through the
+            # host page tables, and with driver R580 on a 64 KiB-page kernel it never
+            # completes when the file pages are not yet mapped and the copy does not
+            # start on a page boundary (the host spins in the copy, the GPU is idle).
+            # A pinned copy reads the file on the CPU and transfers by DMA.
+            source = source.pin_memory()
         destination.copy_(source)
     return destination
 
