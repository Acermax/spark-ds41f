{
  "experiment": "experiments/2026-10-11-moe-fp32",
  "run": "moe-fp32-w1",
  "jobs": [
    {
      "kind": "sync"
    },
    {
      "kind": "kernel",
      "bundles": [
        {
          "node": "dgx1",
          "bundle": "experiments/2026-10-11-moe-fp32/bundles/moefp32"
        }
      ]
    },
    {
      "kind": "fabric",
      "config": "moefp32.json",
      "script": "fabric_moe_reduce.py",
      "args": [
        "--iters",
        "20"
      ],
      "environment": {},
      "label": "moe-reduce"
    },
    {
      "kind": "measure",
      "profile": "lean",
      "bracket": true,
      "extras": [
        [
          "experiments/2026-10-09-tilelang-migration/token_determinism.py",
          [
            "--tokens",
            "192",
            "--long-lines",
            "700",
            "--wide"
          ],
          "determinism"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "1",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c1-distinct"
        ],
        [
          "scripts/distinct_streams.py",
          [
            "--streams",
            "8",
            "--samples",
            "3",
            "--tokens",
            "256"
          ],
          "c8-distinct"
        ],
        [
          "experiments/2026-09-29-determinism/mixed_latency.py",
          [
            "--rounds",
            "3"
          ],
          "mixed"
        ],
        [
          "scripts/acceptance_sweep.py",
          [
            "--tokens",
            "256"
          ],
          "sweep"
        ]
      ],
      "arms": [
        {
          "config": "experiments/2026-10-11-allreduce-rank-order/allreduce.json",
          "label": "allreduce"
        },
        {
          "config": "moefp32.json",
          "label": "moefp32"
        }
      ]
    }
  ]
}
